# ==========================================
# CONFIGURACIÓN GENERAL
# ==========================================
VITE_APP_NAME=POS V2
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# ==========================================
# DATA PROVIDER
# ==========================================
VITE_DATA_PROVIDER=mock

# ==========================================
# SUPABASE (BASE DE DATOS)
# ==========================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ==========================================
# API BACKEND
# ==========================================
VITE_API_URL=http://localhost:3000

# ==========================================
# SOPORTE (OPERADOR INTERNO)
# Coma separada. Solo estos usuarios veran "Centro soporte".
# ==========================================
VITE_SUPPORT_CONSOLE_EMAILS=admin@demo.local
VITE_SUPPORT_CONSOLE_USER_IDS=
VITE_SUPPORT_WHATSAPP_PHONE=5492664689173

# ==========================================
# MERCADO PAGO (CLAVE PÚBLICA)
# ==========================================
VITE_MERCADOPAGO_PUBLIC_KEY=your-mercadopago-public-key

# ==========================================
# INTELIGENCIA ARTIFICIAL (SEGURIDAD CRÍTICA)
# NUNCA usar prefijo VITE_ para claves privadas.
# Las claves de IA se ejecutan exclusivamente en Supabase Edge Functions / Backend (BFF Pattern).
# ==========================================
# OPENAI_API_KEY=tu-clave-secreta-para-backend-edge-functions
# GEMINI_API_KEY=tu-clave-secreta-para-backend-edge-functions

# ==========================================
# FACTURACIÓN ELECTRÓNICA (ARCA)
# ==========================================
VITE_ARCA_API_URL=https://api.arca.gob.ar
VITE_ARCA_ENV=testing

# ==========================================
# CLOUDFLARE R2 (CATÁLOGO GLOBAL & CDN)
# ==========================================
# R2_ACCOUNT_ID=tu-account-id-de-cloudflare
# R2_ACCESS_KEY_ID=tu-access-key-id
# R2_SECRET_ACCESS_KEY=tu-secret-access-key
# R2_BUCKET_NAME=jireh-pos-products
# R2_PUBLIC_URL=https://cdn.jireh.cloud
